// Declarative data model for CMPC-libros.
// The domain never imports from @prisma/client: only infrastructure adapters do.
// Swapping the provider (e.g. MySQL) only requires touching this file + the
// Postgres-specific migration documented in docs/DATABASE.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm powers the GIN indexes used by the free-text search (ILIKE '%term%').
  extensions = [pg_trgm]
}

enum UserRole {
  ADMIN
  EDITOR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  UPLOAD_IMAGE
  EXPORT
  LOGIN
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  name         String     @db.VarChar(120)
  passwordHash String     @map("password_hash")
  role         UserRole   @default(EDITOR)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  auditLogs    AuditLog[]

  @@map("users")
}

model Author {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique @db.VarChar(160)
  books Book[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "authors_name_trgm_idx")
  @@map("authors")
}

model Publisher {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique @db.VarChar(160)
  books Book[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "publishers_name_trgm_idx")
  @@map("publishers")
}

model Genre {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique @db.VarChar(80)
  books Book[]

  @@map("genres")
}

model Book {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(255)
  price       Decimal   @db.Decimal(12, 2)
  isAvailable Boolean   @default(true) @map("is_available")
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  authorId    String    @map("author_id") @db.Uuid
  publisherId String    @map("publisher_id") @db.Uuid
  genreId     String    @map("genre_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  author    Author    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  genre     Genre     @relation(fields: [genreId], references: [id], onDelete: Restrict)

  // Frequent filters always go together with "deleted_at IS NULL".
  @@index([deletedAt, genreId])
  @@index([deletedAt, publisherId])
  @@index([deletedAt, authorId])
  @@index([deletedAt, isAvailable])
  @@index([deletedAt, createdAt])
  @@index([price])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "books_title_trgm_idx")
  @@map("books")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(60)
  entityId   String?     @map("entity_id") @db.VarChar(60)
  userId     String?     @map("user_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
