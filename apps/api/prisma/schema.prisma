// Declarative data model for CMPC-libros.
// The domain never imports from @prisma/client: only infrastructure adapters do.
// Swapping the provider (e.g. MySQL) only requires touching this file + the
// Postgres-specific migration documented in docs/DATABASE.md.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm powers the GIN indexes used by the free-text search (ILIKE '%term%').
  extensions = [pg_trgm]
}

enum UserRole {
  ADMIN
  USER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  UPLOAD_IMAGE
  EXPORT
  LOGIN
  LOGIN_FAILED
  COMPLETE
  CANCEL
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  TRANSFER
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  name         String     @db.VarChar(120)
  passwordHash String     @map("password_hash")
  role         UserRole   @default(USER)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Users are deactivated, never deleted: audit logs keep pointing to their author.
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)
  auditLogs    AuditLog[]
  sales        Sale[]

  @@map("users")
}

model Author {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(160)
  // Calendar date (no time zone): optional because it is not always known.
  birthDate DateTime? @map("birth_date") @db.Date
  biography String?   @db.VarChar(1000)
  books     Book[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "authors_name_trgm_idx")
  @@map("authors")
}

model Publisher {
  id      String  @id @default(uuid()) @db.Uuid
  name    String  @unique @db.VarChar(160)
  // Optional: not every publisher has a known country.
  country String? @db.VarChar(80)
  books   Book[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "publishers_name_trgm_idx")
  @@map("publishers")
}

model Genre {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(80)
  // Optional free text: not every genre needs a description.
  description String? @db.VarChar(500)
  books       Book[]

  @@map("genres")
}

model Book {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(255)
  price       Decimal   @db.Decimal(12, 2)
  // Availability is derived (stock > 0), never stored. CHECK (stock >= 0) lives in the migration SQL.
  stock       Int       @default(0)
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  authorId    String    @map("author_id") @db.Uuid
  publisherId String    @map("publisher_id") @db.Uuid
  genreId     String    @map("genre_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  author    Author     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  publisher Publisher  @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  genre     Genre      @relation(fields: [genreId], references: [id], onDelete: Restrict)
  saleItems SaleItem[]

  // Frequent filters always go together with "deleted_at IS NULL".
  @@index([deletedAt, genreId])
  @@index([deletedAt, publisherId])
  @@index([deletedAt, authorId])
  @@index([deletedAt, stock])
  @@index([deletedAt, createdAt])
  @@index([price])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "books_title_trgm_idx")
  @@map("books")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(60)
  entityId   String?     @map("entity_id") @db.VarChar(60)
  userId     String?     @map("user_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// A sale is PENDING until it is COMPLETED (with a payment method) or CANCELLED; both are final.
// CHECK constraints in the migration SQL keep status, payment method and dates consistent.
model Sale {
  id            String         @id @default(uuid()) @db.Uuid
  status        SaleStatus     @default(PENDING)
  paymentMethod PaymentMethod? @map("payment_method")
  total         Decimal        @db.Decimal(12, 2)
  createdById   String         @map("created_by_id") @db.Uuid
  completedAt   DateTime?      @map("completed_at") @db.Timestamptz(3)
  cancelledAt   DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     SaleItem[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("sales")
}

// unitPrice is a snapshot: later price changes never alter a past sale.
model SaleItem {
  id        String  @id @default(uuid()) @db.Uuid
  saleId    String  @map("sale_id") @db.Uuid
  bookId    String  @map("book_id") @db.Uuid
  quantity  Int // CHECK (quantity > 0) lives in the migration SQL
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@unique([saleId, bookId])
  @@index([bookId])
  @@map("sale_items")
}
