# Copy to apps/api/.env to run the API outside Docker. Validated at startup (src/config/env.validation.ts).

NODE_ENV=development
PORT=3000

# Points at the PostgreSQL container (docker compose up -d db) on the host port.
DATABASE_URL=postgresql://cmpc:cmpc_local_password@localhost:5433/cmpc_libros?schema=public

# Required, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Token lifetime in seconds (minimum 60).
JWT_EXPIRES_IN_SECONDS=3600

# Origin allowed by CORS (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Directory for uploaded book covers, relative to apps/api.
UPLOADS_DIR=uploads
