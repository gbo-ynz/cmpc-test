// CMPC-libros relational model — paste into https://dbdiagram.io to render.
// Source of truth: apps/api/prisma/schema.prisma (and the SQL migrations for the CHECK constraints).

Enum user_role {
  ADMIN
  USER
}

Enum audit_action {
  CREATE
  UPDATE
  DELETE
  UPLOAD_IMAGE
  LOGIN_FAILED
  EXPORT
  LOGIN
  COMPLETE
  CANCEL
}

Enum sale_status {
  PENDING
  COMPLETED
  CANCELLED
}

Enum payment_method {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  TRANSFER
}

Table users {
  id uuid [pk]
  email varchar(255) [unique, not null]
  name varchar(120) [not null]
  password_hash text [not null, note: 'bcrypt; never returned by the API']
  role user_role [not null, default: 'USER']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
  deleted_at timestamptz [note: 'deactivation marker: users are never deleted, audit logs keep pointing to them']
}

Table authors {
  id uuid [pk]
  name varchar(160) [unique, not null]
  birth_date date [note: 'opcional']
  biography varchar(1000) [note: 'opcional']
  indexes {
    name [type: gin, name: 'authors_name_trgm_idx', note: 'gin_trgm_ops']
  }
}

Table publishers {
  id uuid [pk]
  name varchar(160) [unique, not null]
  country varchar(80) [note: 'opcional']
  indexes {
    name [type: gin, name: 'publishers_name_trgm_idx', note: 'gin_trgm_ops']
  }
}

Table genres {
  id uuid [pk]
  name varchar(80) [unique, not null]
  description varchar(500) [note: 'opcional']
}

Table books {
  id uuid [pk]
  title varchar(255) [not null]
  price decimal(12,2) [not null]
  stock int [not null, default: 0, note: 'CHECK (stock >= 0). Availability is derived: stock > 0']
  image_url varchar(500)
  author_id uuid [not null, ref: > authors.id, note: 'ON DELETE RESTRICT']
  publisher_id uuid [not null, ref: > publishers.id, note: 'ON DELETE RESTRICT']
  genre_id uuid [not null, ref: > genres.id, note: 'ON DELETE RESTRICT']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
  deleted_at timestamptz [note: 'soft delete marker']
  indexes {
    (deleted_at, genre_id)
    (deleted_at, publisher_id)
    (deleted_at, author_id)
    (deleted_at, stock)
    (deleted_at, created_at)
    price
    title [type: gin, name: 'books_title_trgm_idx', note: 'gin_trgm_ops']
  }
}

Table sales {
  id uuid [pk]
  status sale_status [not null, default: 'PENDING']
  payment_method payment_method [note: 'required when COMPLETED']
  total decimal(12,2) [not null, note: 'CHECK (total >= 0)']
  created_by_id uuid [not null, ref: > users.id, note: 'ON DELETE RESTRICT']
  completed_at timestamptz [note: 'COMPLETED <=> payment_method and completed_at are set (CHECK)']
  cancelled_at timestamptz [note: 'CANCELLED <=> cancelled_at is set (CHECK)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
  indexes {
    (status, created_at)
    created_at
  }
}

Table sale_items {
  id uuid [pk]
  sale_id uuid [not null, ref: > sales.id, note: 'ON DELETE CASCADE']
  book_id uuid [not null, ref: > books.id, note: 'ON DELETE RESTRICT']
  quantity int [not null, note: 'CHECK (quantity > 0)']
  unit_price decimal(12,2) [not null, note: 'price snapshot: later price changes never alter a past sale']
  indexes {
    (sale_id, book_id) [unique]
    book_id
  }
}

Table audit_logs {
  id uuid [pk]
  action audit_action [not null]
  entity_type varchar(60) [not null]
  entity_id varchar(60)
  user_id uuid [ref: > users.id, note: 'ON DELETE SET NULL']
  metadata jsonb
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (entity_type, entity_id)
    (user_id, created_at)
  }
}
