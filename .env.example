# Copy to .env next to docker-compose.yml. Defaults in the compose file are for local use only.

# PostgreSQL password, also used to build the API's DATABASE_URL.
POSTGRES_PASSWORD=cmpc_local_password

# Host port that exposes PostgreSQL (5433 avoids clashing with a local PostgreSQL on 5432).
DB_HOST_PORT=5433

# JWT signing secret, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
